POSTGRES_PORT=2001
GATEWAY_PORT=2002
INGESTION_PORT=2004
ANALYTICS_PORT=2005
CLUSTERING_PORT=2006
PREDICTION_PORT=2007
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

ANALYTICS_POSTGRES_USER=root
ANALYTICS_POSTGRES_PASSWORD=123456
PROCESSED_POSTGRES_DB=flight_processed_db
RAW_POSTGRES_DB=flight_raw_db

INGESTION_SCHEDULER_ENABLED=true
ANALYTICS_SCHEDULER_ENABLED=true
CLUSTERING_SCHEDULER_ENABLED=true
PREDICTION_SCHEDULER_ENABLED=true

INGESTION_RUN_ON_STARTUP=true
CLUSTERING_RUN_ON_STARTUP=true

INGESTION_INTERVAL_SECONDS=300
ANALYTICS_INTERVAL_SECONDS=300
CLUSTERING_INTERVAL_SECONDS=86400
PREDICTION_INTERVAL_SECONDS=300


# Optional downstream webhooks after a successful ingestion batch
TRIGGER_DOWNSTREAM_URLS=

# Live APIs. Keys stay on the backend; do not commit .env.
# Budgets count schedules, pagination, airport lookups and failed requests.
# RESET_DAY is the UTC billing-cycle start (1..28); match your provider dashboard.
AIRLABS_API_KEY=
AIRLABS_AIRPORTS=JFK
AIRLABS_MAX_PAGES=1
AIRLABS_MONTHLY_BUDGET=800
AIRLABS_RESET_DAY=1
AIRLABS_ACCOUNTS=
OPENWEATHER_API_KEY=
OPENWEATHER_MONTHLY_BUDGET=10000
OPENWEATHER_RESET_DAY=1
WEATHER_CACHE_SECONDS=900
