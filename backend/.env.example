GATEWAY_PORT=8080
FRONTEND_PORT=3000
SIMULATOR_PORT=8000
POSTGRES_PORT=5432
FRONTEND_ORIGIN=http://localhost:3000

POSTGRES_USER=flight
POSTGRES_PASSWORD=flight
POSTGRES_DB=flight_db
DATABASE_URL=postgresql://flight:flight@postgres:5432/flight_db

# Schedulers (set to true for automatic background runs)
INGESTION_SCHEDULER_ENABLED=true
ANALYTICS_SCHEDULER_ENABLED=false
CLUSTERING_SCHEDULER_ENABLED=true
PREDICTION_SCHEDULER_ENABLED=false

INGESTION_RUN_ON_STARTUP=true
CLUSTERING_RUN_ON_STARTUP=true

INGESTION_INTERVAL_SECONDS=300
ANALYTICS_INTERVAL_SECONDS=300
CLUSTERING_INTERVAL_SECONDS=86400
PREDICTION_INTERVAL_SECONDS=300

# Data simulator configuration
SIMULATOR_BASE_URL=http://data-simulator:8000
SIMULATOR_WINDOW_SIZE=100
SIMULATOR_SLIDE_STEP=20

# Downstream webhook trigger from ingestion to clustering
TRIGGER_DOWNSTREAM_URLS=http://clustering:8000/run
