# Official nginx image substitutes FRONTEND_ORIGIN at container startup.
map $http_origin $cors_origin {
    default "";
    "${FRONTEND_ORIGIN}" $http_origin;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    absolute_redirect off;
    client_max_body_size 1m;

    # Resolve Compose service names again after containers are recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $analytics_upstream http://analytics:8000;
    set $clustering_upstream http://clustering:8000;
    set $prediction_upstream http://prediction:8000;
    set $ingestion_upstream http://ingestion:8000;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;

    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
    add_header Vary Origin always;

    if ($request_method = OPTIONS) {
        return 204;
    }

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","service":"gateway"}';
    }

    location = / {
        default_type application/json;
        return 200 '{"service":"gateway","docs":["/api/ingestion/docs","/api/analytics/docs","/api/clustering/docs","/api/prediction/docs"]}';
    }

    location = /api/analytics {
        return 308 /api/analytics/$is_args$args;
    }

    location /api/analytics/ {
        rewrite ^/api/analytics/(.*)$ /$1 break;
        proxy_pass $analytics_upstream;
    }

    location = /api/clustering {
        return 308 /api/clustering/$is_args$args;
    }

    location /api/clustering/ {
        rewrite ^/api/clustering/(.*)$ /$1 break;
        proxy_pass $clustering_upstream;
    }

    location = /api/prediction {
        return 308 /api/prediction/$is_args$args;
    }

    location /api/prediction/ {
        rewrite ^/api/prediction/(.*)$ /$1 break;
        proxy_pass $prediction_upstream;
    }

    location = /api/ingestion {
        return 308 /api/ingestion/$is_args$args;
    }

    location /api/ingestion/ {
        rewrite ^/api/ingestion/(.*)$ /$1 break;
        proxy_pass $ingestion_upstream;
    }

    location / {
        default_type application/json;
        return 404 '{"detail":"Route not found"}';
    }
}
